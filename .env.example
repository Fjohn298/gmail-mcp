# Copia este archivo como .env (no se versiona) y ejecuta con:
#   uv run --env-file .env python dashboard.py

# development | production. En Railway, si falta, se deduce de RAILWAY_ENVIRONMENT_NAME.
APP_ENV=development

# true = lee Gmail pero no etiqueta, borra ni envía correos. Por defecto true en development.
DRY_RUN=true

# Clave para firmar la cookie de sesión. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# Definirla activa el login del dashboard (REQUIRE_LOGIN=false lo desactiva explícitamente).
DASHBOARD_PASSWORD=
# REQUIRE_LOGIN=true

PORT=5000

# Solo en servidores sin navegador (Railway): contenido de token.json y credentials.json
# GMAIL_TOKEN_JSON=
# GMAIL_CREDENTIALS_JSON=
